# ClincClick backend environment template (Phase 01)
# Copy this file to `backend/.env` and fill in the real values.
# Real .env files must never be committed to Git.

# Application
APP_NAME=Service Booking API
APP_ENV=development
DEBUG=True

# PostgreSQL connection (managed locally via pgAdmin 4)
# Replace YOUR_PASSWORD with your real local PostgreSQL password.
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/service_booking_db

# JWT / authentication (change to a long, secure random string)
SECRET_KEY=CHANGE_THIS_TO_A_SECURE_RANDOM_SECRET
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS
FRONTEND_URL=http://localhost:5173

# Rate limiting for authentication endpoints (defaults shown)
RATE_LIMIT_AUTH_ATTEMPTS=10
RATE_LIMIT_AUTH_WINDOW_SECONDS=60

# Refresh-token cookie
REFRESH_COOKIE_NAME=refresh_token
REFRESH_COOKIE_SECURE=False

# Secure admin bootstrap (run: python -m app.db.init_db)
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_FULL_NAME=
